# .env file committed because it does not contain sensitive information. It is used to configure the default model and API base for LiteLLM.
# Useful for local development and testing. In production, these values can be overridden by environment variables or Docker Compose settings.
# Default Model for LiteLLM
#DEFAULT_ANALYSIS_MODEL="ollama/qwen2.5:7b"
DEFAULT_ANALYSIS_MODEL="ollama/qwen2.5:14b"
DEFAULT_CONVERSATION_MODEL="ollama/qwen2.5:7b"
KEEP_ALIVE=0
# API Base URL for LiteLLM
API_BASE="http://localhost:11434"

#Path to CV
CV_PATH="~/Desktop/misc/Migrating to Switzerland/SwissCV/alexandre_cunha_cv.pdf"

